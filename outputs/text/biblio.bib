}

@ARTICLE{Merlo2006-sh,
  title     = "Cancer as an evolutionary and ecological process",
  author    = "Merlo, Lauren M F and Pepper, John W and Reid, Brian J and
               Maley, Carlo C",
  abstract  = "Neoplasms are microcosms of evolution. Within a neoplasm, a
               mosaic of mutant cells compete for space and resources, evade
               predation by the immune system and can even cooperate to
               disperse and colonize new organs. The evolution of neoplastic
               cells explains both why we get cancer and why it has been so
